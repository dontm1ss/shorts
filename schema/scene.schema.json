{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dontm1ss/shorts/schema/scene.schema.json",
  "title": "Scene",
  "description": "Контракт сцены между модулями конвейера. Блоки audio/subtitles/background заполняются по мере прохождения этапов, поэтому на ранних этапах могут отсутствовать.",
  "type": "object",
  "required": ["scene_id", "type", "created_at", "output"],
  "additionalProperties": false,
  "properties": {
    "scene_id": { "type": "string", "format": "uuid" },
    "type": { "enum": ["imessage_drama", "reddit_story", "video_clip"] },
    "created_at": { "type": "string", "format": "date-time" },

    "script": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["speaker", "text"],
        "additionalProperties": false,
        "properties": {
          "speaker": {
            "type": "string",
            "pattern": "^(narrator|[A-Z])$",
            "description": "narrator — диктор; A, B, C… — роли переписки"
          },
          "text": { "type": "string", "minLength": 1 },
          "emotion": {
            "enum": ["neutral", "anger", "sad", "sarcasm", "anxious", "shock", "joy", "tired", "warm", "guilty"],
            "description": "интонация реплики (размечает DeepSeek, src/core/emotions.py): озвучка берёт референс voices/<пол>/<эмоция>.wav и поправку подачи tts.emotions; нет поля — neutral"
          },
          "stressed_text": { "type": "string", "description": "текст с ударениями (U+0301), заполняет TTS-модуль" },
          "timestamp_ms": { "type": "integer", "minimum": 0, "description": "начало реплики в общем аудио" },
          "duration_ms": { "type": "integer", "minimum": 0, "description": "длительность реплики в общем аудио, заполняет TTS-модуль" }
        }
      }
    },

    "audio": {
      "type": "object",
      "required": ["path", "duration_ms"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "words_path": {
          "type": "string", "minLength": 1,
          "description": "пословные таймкоды из проверки озвучки whisper'ом (JSON) — субтитры берут их без повторного распознавания"
        },
        "tts_params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exaggeration": { "type": "number", "minimum": 0 },
            "cfg_weight": { "type": "number", "minimum": 0 },
            "temperature": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },

    "subtitles": {
      "type": "object",
      "required": ["path", "format"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "enum": ["srt", "ass"] }
      }
    },

    "background": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "start_ms": { "type": "integer", "minimum": 0 }
      },
      "if": { "not": { "properties": { "type": { "const": "none" } } } },
      "then": { "required": ["source_path", "start_ms"] }
    },

    "source_video": {
      "type": "object",
      "required": ["path", "clip_start_ms", "clip_end_ms"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "clip_start_ms": { "type": "integer", "minimum": 0 },
        "clip_end_ms": { "type": "integer", "minimum": 1 },
        "words_path": {
          "type": "string", "minLength": 1,
          "description": "распознанные слова всего исходника (JSON, время от начала исходника) — один проход whisper на все отрезки"
        }
      }
    },

    "meta": {
      "type": "object",
      "description": "данные конкретного формата: title, contacts (iMessage), source (форум) и т.п.",
      "properties": {
        "style": {
          "type": "object",
          "description": "оформление субтитров сцены (subtitles.variety): font, size, highlight_color",
          "properties": {
            "font": { "type": "string", "minLength": 1 },
            "size": { "type": "integer", "minimum": 20 },
            "highlight_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        },
        "review": {
          "type": "object",
          "description": "отбор сценария в веб-панели",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["pending", "approved", "rejected"] }
          }
        },
        "genders": {
          "type": "object",
          "description": "пол героев по ролям — выбор голоса озвучки (tts.voices.female / male)",
          "propertyNames": { "pattern": "^(narrator|[A-Z])$" },
          "additionalProperties": { "enum": ["female", "male"] }
        },
        "loop": {
          "type": "boolean",
          "description": "петля: ролик крутится по кругу — последнее сообщение переходит в первое, в конце нет хвоста, на стыке переписка продолжается (imessage, compositor)"
        },
        "loop_idea": {
          "type": "string",
          "description": "как DeepSeek склеил конец петли с началом — одной фразой, для отбора в панели"
        }
      }
    },

    "output": {
      "type": "object",
      "required": ["resolution", "path"],
      "additionalProperties": false,
      "properties": {
        "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  },

  "allOf": [
    {
      "if": { "properties": { "type": { "const": "video_clip" } } },
      "then": { "required": ["source_video"] },
      "else": {
        "required": ["script"],
        "properties": { "source_video": false }
      }
    }
  ]
}
