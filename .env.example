DEEPSEEK_API_KEY=sk-...

# Необязательно: приложение Reddit типа "script" (https://www.reddit.com/prefs/apps) —
# сбор постов через официальный API вместо RSS с жёстким лимитом
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Бот в Telegram: токен от @BotFather (без скобок и кавычек); чат подключается кнопкой
# «Подключить Telegram» в панели (или `python -m notify setup` после /start боту)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Профиль железа выбирается автоматически (config/profiles/).
# Раскомментировать, чтобы задать вручную:
# SHORTS_PROFILE=win10_nvidia_gtx1060 | win11_amd | mac_apple_silicon
